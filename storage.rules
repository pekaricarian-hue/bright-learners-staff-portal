rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email.lower() == "pekaric.arian@gmail.com" ||
        request.auth.token.email.lower() == "admin@brightlearnersacademy.net"
      );
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
    }

    match /inspection-evidence/{userId}/{allPaths=**} {
      allow read, write: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
    }

    match /generated-reports/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
