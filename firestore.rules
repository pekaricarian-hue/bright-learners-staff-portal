rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : "";
    }

    function isOwner() {
      return verified() && email() == "pekaric.arian@gmail.com";
    }

    function isAdmin() {
      return isOwner() || (verified() && email() == "admin@brightlearnersacademy.net");
    }

    function isDirector() {
      return verified() && email() in [
        "sylvandaycare@gmail.com",
        "sundance@brightlearnersacademy.net",
        "midnapore@brightlearnersacademy.net",
        "millwoods@brightlearnersacademy.net",
        "willowgrove@brightlearnersacademy.net",
        "vick@brightlearnersacademy.net",
        "darin@brightlearnersacademy.net",
        "imroz@brightlearnersacademy.net",
        "ruby@brightlearnersacademy.net",
        "payroll@brightlearnersacademy.net"
      ];
    }

    function correctRole() {
      return (isOwner() && request.resource.data.role == "owner")
        || (!isOwner() && email() == "admin@brightlearnersacademy.net" && request.resource.data.role == "admin")
        || (!isAdmin() && isDirector() && request.resource.data.role == "director")
        || (exists(/databases/$(database)/documents/staffInvitations/$(email()))
          && request.resource.data.role == get(/databases/$(database)/documents/staffInvitations/$(email())).data.role)
        || (!isAdmin() && !isDirector() && request.resource.data.role == "employee");
    }

    function owns(userId) {
      return verified() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && correctRole();
      allow update: if isAdmin() || (owns(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.location == resource.data.location
        && request.resource.data.province == resource.data.province);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if verified();
      allow write: if isAdmin();
    }

    match /academyLocations/{locationId} {
      allow read: if verified();
      allow write: if isAdmin();
    }

    match /contentOverrides/{contentId} {
      allow read: if verified();
      allow write: if isAdmin();
    }

    match /staffInvitations/{invitationEmail} {
      allow read: if isAdmin() || (verified() && invitationEmail == email());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (verified()
        && invitationEmail == email()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.location == resource.data.location
        && request.resource.data.province == resource.data.province
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedBy == request.auth.uid);
    }

    match /progress/{progressId} {
      allow read: if verified() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if verified() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if verified() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /inspections/{inspectionId} {
      allow read: if verified() &&
        (resource.data.directorId == request.auth.uid || isAdmin());
      allow create: if verified() &&
        request.resource.data.directorId == request.auth.uid;
      allow update: if verified() &&
        resource.data.directorId == request.auth.uid &&
        request.resource.data.directorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /inspectionDrafts/{draftId} {
      allow read: if verified() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if verified() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if verified() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if verified() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if verified() &&
        request.resource.data.userId == request.auth.uid &&
        (isOwner() ||
          get(/databases/$(database)/documents/progress/$(request.auth.uid + "_" + request.resource.data.courseId)).data.completedModules.size() == 8);
      allow update: if verified() &&
        request.resource.data.userId == resource.data.userId &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if verified() &&
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
